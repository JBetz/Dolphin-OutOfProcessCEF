Object subclass: #RpcResponse
	instanceVariableNames: 'requestId success returnValue error'
	classVariableNames: ''
	poolDictionaries: ''
	classInstanceVariableNames: ''!

ChromiumObject subclass: #HttpRequest
	instanceVariableNames: 'id client'
	classVariableNames: ''
	poolDictionaries: ''
	classInstanceVariableNames: ''!

ChromiumObject subclass: #WebBrowser
	instanceVariableNames: 'id client view navigator'
	classVariableNames: 'ContextMenuCommandMap CursorMap'
	poolDictionaries: 'CefConstants Win32Constants'
	classInstanceVariableNames: ''!

"Loose Methods"!

!KernelLibrary methodsFor!

getCurrentProcessId
	"Answer thread identifier of the currently executing thread (like Processor activeProcess).

		DWORD GetCurrentProcessId(VOID)"

	<stdcall: dword GetCurrentProcessId>
	^self invalidCall: _failureCode!

getProcessId: aHandle
	"Retrieves the process identifier of the specified process.

		DWORD GetProcessId(
			[in] HANDLE Process
		);"

	<stdcall: dword GetProcessId handle>
	^self invalidCall: _failureCode! !

!KernelLibrary categoriesForMethods!
getCurrentProcessId!public!win32 functions-process and thread! !
getProcessId:!public!win32 functions-process and thread! !
!

!Object methodsFor!

asDictionary
	| dictionary |
	dictionary := Dictionary new.
	self class instVarNames
		do: [:name | dictionary at: name asSymbol put: (self perform: name asSymbol)].
	^dictionary! !

!Object categoriesForMethods!
asDictionary!public! !
!

!Object class methodsFor!

fromDictionary: aDictionary
	| instance |
	instance := self new.
	aDictionary associationsDo: [:key :value | instance perform: (key , ':') asSymbol with: value].
	^instance! !

!Object class categoriesForMethods!
fromDictionary:!public! !
!

"End of package definition"!

