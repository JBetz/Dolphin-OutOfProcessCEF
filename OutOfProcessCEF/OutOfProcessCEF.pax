	classInstanceVariableNames: ''!

Object subclass: #CefTransitionType
	instanceVariableNames: 'code'
	classVariableNames: ''
	poolDictionaries: 'CefConstants'
	classInstanceVariableNames: ''!

Object subclass: #ChromiumClient
	instanceVariableNames: 'id process socket windowManager remoteObjects callbacks windowMessageId readyEvent'
	classVariableNames: 'Singleton'
	poolDictionaries: 'Win32Constants'
	classInstanceVariableNames: ''!

Object subclass: #ChromiumObject
	instanceVariableNames: 'model'
	classVariableNames: ''
	poolDictionaries: ''
	classInstanceVariableNames: ''!

Object subclass: #ContextMenuCommand
	instanceVariableNames: 'index commandId label'
	classVariableNames: ''
	poolDictionaries: ''
	classInstanceVariableNames: ''!

Object subclass: #ContextMenuConfiguration
	instanceVariableNames: 'commands'
	classVariableNames: ''
	poolDictionaries: ''
	classInstanceVariableNames: ''!

Object subclass: #DownloadConfiguration
	instanceVariableNames: 'shouldContinue downloadPath showDialog'
	classVariableNames: ''
	poolDictionaries: ''
	classInstanceVariableNames: ''!

Object subclass: #DownloadItem
	instanceVariableNames: 'isInProgress isComplete isCanceled isInterrupted isPaused interruptReason currentSpeed percentComplete totalBytes receivedBytes startTime endTime fullPath id url originalUrl suggestedFileName contentDisposition mimeType'
	classVariableNames: ''
	poolDictionaries: ''
	classInstanceVariableNames: ''!

Object subclass: #HttpResponse
	instanceVariableNames: 'headers body statusCode statusText'
	classVariableNames: ''
	poolDictionaries: ''
	classInstanceVariableNames: ''!

Object subclass: #ImageDownload
	instanceVariableNames: 'imageUrl httpStatusCode images'
