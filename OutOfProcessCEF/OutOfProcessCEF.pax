| package |
package := Package name: 'OutOfProcessCEF'.
package paxVersion: 1;
	basicComment: ''.

package classNames
	add: #BrowseEvent;
	add: #CefKeyboardEvent;
	add: #CefMouseEvent;
	add: #CefRectangle;
	add: #CefTransitionType;
	add: #ChromiumClient;
	add: #ChromiumObject;
	add: #ContextMenuCommand;
	add: #ContextMenuConfiguration;
	add: #DownloadConfiguration;
	add: #DownloadItem;
	add: #HttpRequest;
	add: #HttpResponse;
	add: #ImageDownload;
	add: #PNGImageData;
	add: #RpcCallbackMethodBuilder;
	add: #RpcResponse;
	add: #WebBrowser;
	yourself.

package methodNames
	add: #KernelLibrary -> #getCurrentProcessId;
	add: #KernelLibrary -> #getProcessId:;
	add: #Object -> #asDictionary;
	add: 'Object class' -> #fromDictionary:;
	yourself.

package globalNames
	add: #CefConstants;
	yourself.

package binaryGlobalNames: (Set new
	yourself).

package globalAliases: (Set new
	yourself).

package setPrerequisites: #(
	'..\Core\Object Arts\Dolphin\Base\Dolphin'
	'..\Core\Contributions\Burning River\ExternalProcess\ExternalProcess'
	'..\Dolphin-SDL\SDL3\SDL3'
	'..\Core\Contributions\svenc\STON\STON-Core').

package!

"Class Definitions"!

